D": "Tidak membeli karena bukan kebutuhan."}, "ranking": ["D", "B", "A", "C"]}, {"situasi": "Di akhir bulan kamu masih memiliki uang Rp100.000.", "options": {"A": "Menghabiskan semuanya.", "B": "Menabung seluruhnya.", "C": "Meminjam uang teman agar uang sendiri tetap utuh.", "D": "Menabung sebagian dan menyimpan sebagian untuk kebutuhan mendadak."}, "ranking": ["D", "B", "A", "C"]}, {"situasi": "Seseorang menawarkan investasi dengan keuntungan 30% per bulan tanpa risiko.", "options": {"A": "Langsung ikut.", "B": "Mengajak teman ikut bersama.", "C": "Mengecek legalitas dan memahami produknya terlebih dahulu.", "D": "Mencoba sedikit dulu."}, "ranking": ["C", "D", "B", "A"]}, {"situasi": "Kamu sedang menabung untuk membeli laptop, tetapi ada sepatu yang sedang tren.", "options": {"A": "Membeli sepatu.", "B": "Mengurangi tabungan agar bisa membeli sepatu.", "C": "Tetap menabung sesuai target.", "D": "Meminjam uang untuk membeli sepatu."}, "ranking": ["C", "B", "A", "D"]}, {"situasi": "Selama satu minggu kamu tidak pernah mencatat pengeluaran.", "options": {"A": "Mulai mencatat seluruh pemasukan dan pengeluaran.", "B": "Mengingat saja tanpa mencatat.", "C": "Mencatat jika pengeluarannya besar.", "D": "Tidak perlu mencatat karena uang masih ada."}, "ranking": ["A", "C", "B", "D"]}]}};

const CATEGORY_META = {
  "Keputusan Finansial": { icon:"💰", desc:"Kelola uang saku secara bijak" },
  "Peluang Bisnis":      { icon:"💼", desc:"Simulasi usaha kecil santri" },
  "Investasi":           { icon:"📈", desc:"Simulasi investasi syariah" },
  "Rezeki":              { icon:"🌟", desc:"Nikmat tak terduga" },
  "Musibah":             { icon:"⚠️", desc:"Menghadapi risiko & kerugian" },
  "Sedekah":             { icon:"🤲", desc:"Kepedulian & berbagi" },
  "Tantangan":           { icon:"🔥", desc:"Uji ketahanan finansialmu" },
};

/* ============== STATE ============== */
let state = {
  screen: "home",           // home | literasi-play | aksi-play
  category: null,
  cardIndex: null,
  selectedOption: null,
  revealed: false,
  diceValue: null,
  diceRolling: false,
  showDiceTable: false,
};

const app = document.getElementById("app");

function resetCardState(){
  state.selectedOption = null;
  state.revealed = false;
  state.diceValue = null;
  state.diceRolling = false;
  state.showDiceTable = false;
}

function goHome(){
  state.screen = "home";
  state.category = null;
  state.cardIndex = null;
  resetCardState();
  render();
}

function startLiterasi(){
  state.screen = "literasi-play";
  state.cardIndex = Math.floor(Math.random()*LITERASI_DATA.length);
  resetCardState();
  render();
}

function pickRandomAksi(excludeCategory, excludeIndex){
  const catNames = Object.keys(AKSI_DATA);
  let catName, idx;
  // avoid repeating the exact same card twice in a row when possible
  let tries = 0;
  do{
    catName = catNames[Math.floor(Math.random()*catNames.length)];
    const cards = AKSI_DATA[catName].cards;
    idx = Math.floor(Math.random()*cards.length);
    tries++;
  } while(tries<8 && catName===excludeCategory && idx===excludeIndex);
  return {catName, idx};
}

function startAksiRandom(){
  const {catName, idx} = pickRandomAksi(state.category, state.cardIndex);
  state.screen = "aksi-play";
  state.category = catName;
  state.cardIndex = idx;
  resetCardState();
  render();
}

function shuffleCurrent(){
  resetCardState();
  if(state.screen === "literasi-play"){
    let idx;
    do{ idx = Math.floor(Math.random()*LITERASI_DATA.length); }
    while(LITERASI_DATA.length>1 && idx===state.cardIndex);
    state.cardIndex = idx;
  } else if(state.screen === "aksi-play"){
    const {catName, idx} = pickRandomAksi(state.category, state.cardIndex);
    state.category = catName;
    state.cardIndex = idx;
  }
  render();
}

function selectOption(letter){
  if(state.revealed) return;
  state.selectedOption = letter;
  render();
}

function revealAnswer(){
  state.revealed = true;
  render();
}

function toggleDiceTable(){
  state.showDiceTable = !state.showDiceTable;
  render();
}

function rollDice(){
  if(state.diceRolling) return;
  state.diceRolling = true;
  render();
  setTimeout(()=>{
    state.diceValue = 1 + Math.floor(Math.random()*6);
    state.diceRolling = false;
    render();
  }, 420);
}

/* ============== RENDER HELPERS ============== */
function diffLabel(diff){
  if(diff==="mudah") return {cls:"diff-mudah", text:"🟢 Mudah"};
  if(diff==="sedang") return {cls:"diff-sedang", text:"🟡 Sedang"};
  return {cls:"diff-sulit", text:"🔴 Sulit"};
}

function stepIsMaju(text){
  return /maju/i.test(text);
}

function topbarHTML(showBack, backFn, title, subtitle){
  return `
    <div class="topbar">
      <div class="brand">
        <div class="brand-mark">🕌</div>
        <div class="brand-text">
          <div class="eyebrow">Jejak Finansial Santri</div>
          <h1>${title || "Kartu Digital"}</h1>
        </div>
      </div>
      ${showBack ? `<button class="back-btn" onclick="${backFn}">← Kembali</button>` : ""}
    </div>
  `;
}

/* ============== SCREENS ============== */
function renderHome(){
  app.innerHTML = `
    ${topbarHTML(false, "", "Kartu Digital")}
    <div class="panel">
      <div class="hero">
        <div class="kicker">Board Game Edukasi Literasi Keuangan Syariah</div>
        <h2>Pilih jenis kartu untuk dimainkan</h2>
        <p>Pemain berhenti di petak hijau atau kuning pada papan, lalu membuka kartu digital yang sesuai di sini.</p>
      </div>
      <div class="choice-grid">
        <div class="choice-card literasi" onclick="startLiterasi()">
          <span class="cc-icon">📚</span>
          <h3>Kartu Literasi</h3>
          <p>Soal pilihan ganda seputar keuangan syariah, menabung, investasi, hingga kewirausahaan santri.</p>
          <span class="cc-count">${LITERASI_DATA.length} kartu</span>
        </div>
        <div class="choice-card aksi" onclick="startAksiRandom()">
          <span class="cc-icon">🧭</span>
          <h3>Kartu Aksi</h3>
          <p>Simulasi situasi nyata: ambil keputusan atau lempar dadu untuk melihat konsekuensinya.</p>
          <span class="cc-count">${Object.values(AKSI_DATA).reduce((n,c)=>n+c.cards.length,0)} kartu · 7 kategori</span>
        </div>
      </div>
    </div>
    <div class="footer-note">Petak 📚 hijau → Kartu Literasi &nbsp;•&nbsp; Petak 🧭 kuning → Kartu Aksi<br>Politeknik Negeri Bandung — D4 Keuangan Syariah</div>
  `;
}

function renderLiterasiPlay(){
  const card = LITERASI_DATA[state.cardIndex];
  const d = diffLabel(card.difficulty);
  const letters = ["A","B","C","D"];

  const optionsHTML = letters.map(letter=>{
    const isSelected = state.selectedOption === letter;
    const isCorrect = letter === card.answer;
    let cls = "opt-btn";
    if(state.revealed){
      if(isCorrect) cls += " correct-answer";
      else if(isSelected) cls += " wrong-selected";
    } else if(isSelected){
      cls += " selected";
    }
    return `
      <button class="${cls}" onclick="selectOption('${letter}')" ${state.revealed?"disabled":""}>
        <span class="opt-letter">${letter}</span>
        <span>${card.options[letter]}</span>
        ${state.revealed && isCorrect ? `<span class="opt-result result-maju" style="background:transparent;">✓ Jawaban Benar</span>` : ""}
      </button>
    `;
  }).join("");

  const answerBox = state.revealed ? `
    <div class="answer-box">
      <div class="ab-title">Pembahasan</div>
      <div style="font-size:13.5px;line-height:1.6;color:#EFE6C8;">
        Jawaban yang tepat adalah <b style="color:var(--gold-300)">${card.answer}</b> — “${card.options[card.answer]}”.
        ${state.selectedOption ? (state.selectedOption===card.answer
          ? `<br><br>🎉 Pilihanmu tepat! Maju <b style="color:#B7E8C9">${card.steps} langkah</b>.`
          : `<br><br>Pilihanmu belum tepat. Mundur <b style="color:#F3C2B4">${card.steps} langkah</b>, lalu pelajari alasannya bersama fasilitator.`) : ""}
      </div>
    </div>
  ` : "";

  app.innerHTML = `
    ${topbarHTML(true, "goHome()", "Kartu Literasi")}
    <div class="panel">
      <div class="mode-title"><span class="mi">📚</span><h2>Kartu Literasi Keuangan Syariah</h2></div>
      <div class="mode-sub">Soal ${card.id} dari ${LITERASI_DATA.length}</div>

      <div class="card-stage">
        <div class="card-face">
          <span class="card-id">#${String(card.id).padStart(2,"0")}</span>
          <span class="difficulty-badge ${d.cls}">${d.text} · ${state.revealed ? "" : "+"}${card.steps} Langkah</span>
          <div class="card-question">${card.question}</div>
          <div class="options">${optionsHTML}</div>
        </div>
      </div>

      ${answerBox}

      <div class="btn-row">
        <button class="btn btn-gold" onclick="shuffleCurrent()">🔀 Acak Kartu</button>
        <button class="btn btn-primary" onclick="revealAnswer()" ${state.revealed?"disabled":""}>👁 Tampilkan Jawaban</button>
      </div>
    </div>
  `;
}

function renderAksiPlay(){
  const cat = AKSI_DATA[state.category];
  const meta = CATEGORY_META[state.category];
  const card = cat.cards[state.cardIndex];

  if(cat.type === "ranking"){
    renderAksiRanking(cat, meta, card);
  } else {
    renderAksiDice(cat, meta, card);
  }
}

function renderAksiRanking(cat, meta, card){
  const letters = ["A","B","C","D"];
  const stepFor = (letter)=>{
    const pos = card.ranking.indexOf(letter); // 0..3
    const steps = [ {n:3,dir:"Maju"}, {n:2,dir:"Maju"}, {n:1,dir:"Maju"}, {n:1,dir:"Mundur"} ];
    return steps[pos];
  };

  const optionsHTML = letters.map(letter=>{
    const isSelected = state.selectedOption === letter;
    const st = stepFor(letter);
    const isMaju = st.dir === "Maju";
    let cls = "opt-btn";
    if(isSelected) cls += " selected " + (isMaju ? "result-maju" : "result-mundur");
    return `
      <button class="${cls}" onclick="selectOption('${letter}')">
        <span class="opt-letter">${letter}</span>
        <span>${card.options[letter]}</span>
        ${isSelected ? `<span class="opt-result">${st.dir} ${st.n}</span>` : ""}
      </button>
    `;
  }).join("");

  const answerBox = state.revealed ? `
    <div class="answer-box">
      <div class="ab-title">Urutan Keputusan Terbaik</div>
      ${card.ranking.map((letter,i)=>{
        const st = stepFor(letter);
        const isMaju = st.dir === "Maju";
        return `
          <div class="rank-row">
            <span class="rank-pos">${i+1}</span>
            <span class="rank-letter">${letter}</span>
            <span class="rank-text">${card.options[letter]}</span>
            <span class="rank-step ${isMaju?"maju":"mundur"}">${st.dir} ${st.n}</span>
          </div>
        `;
      }).join("")}
    </div>
  ` : "";

  app.innerHTML = `
    ${topbarHTML(true, "goHome()", "Kartu Aksi")}
    <div class="panel">
      <div class="mode-title"><span class="mi">${meta.icon}</span><h2>${state.category}</h2></div>
      <div class="mode-sub">🎴 Kategori terpilih acak · Pilih tindakan A–D</div>

      <div class="card-stage">
        <div class="card-face">
          <div class="card-question">${card.situasi}</div>
          <div class="options">${optionsHTML}</div>
        </div>
      </div>

      ${answerBox}

      <div class="btn-row">
        <button class="btn btn-gold" onclick="shuffleCurrent()">🔀 Acak Kartu</button>
        <button class="btn btn-primary" onclick="revealAnswer()" ${state.revealed?"disabled":""}>👁 Tampilkan Jawaban</button>
      </div>
    </div>
  `;
}

function renderAksiDice(cat, meta, card){
  const table = cat.table;
  const diceOutcome = state.diceValue ? table[state.diceValue] : null;
  const diceIsMaju = diceOutcome ? stepIsMaju(diceOutcome.hasil) : null;

  const diceResultHTML = state.diceValue ? `
    <div style="margin-top:12px;">
      <div class="dice-result-text">Dadu menunjukkan angka <b>${state.diceValue}</b> → <b>${diceOutcome.kejadian}</b></div>
      <span class="dice-outcome-pill" style="background:${diceIsMaju?"var(--maju-bg)":"var(--mundur-bg)"};color:${diceIsMaju?"var(--maju)":"var(--mundur)"};">${diceOutcome.hasil}</span>
    </div>
  ` : `<div class="dice-result-text" style="margin-top:12px;">Tekan “Lempar Dadu” untuk melihat hasilnya.</div>`;

  const diceTableHTML = state.showDiceTable ? `
    <div class="answer-box" style="background:var(--paper); color:var(--ink);">
      <div class="ab-title" style="color:var(--gold-600);">🎲 Tabel Hasil Dadu — ${state.category}</div>
      <table class="dice-table">
        <thead><tr><th>Dadu</th><th>Kejadian</th><th>Langkah</th></tr></thead>
        <tbody>
          ${[1,2,3,4,5,6].map(n=>{
            const row = table[n];
            const maju = stepIsMaju(row.hasil);
            return `<tr><td>🎲 ${n}</td><td>${row.kejadian}</td><td class="step-cell ${maju?"maju":"mundur"}">${row.hasil}</td></tr>`;
          }).join("")}
        </tbody>
      </table>
      ${cat.table_source==="authored-placeholder" ? `<div class="table-note">Catatan: tabel dadu untuk kategori Musibah belum tercantum eksplisit pada Buku Kartu Aksi sumber, sehingga disusun mengikuti pola kategori lain (dapat disesuaikan fasilitator sebelum dicetak).</div>` : ""}
    </div>
  ` : "";

  const pelajaranHTML = card.pelajaran ? `
    <div class="pelajaran-box"><b>Pelajaran:</b> ${card.pelajaran}</div>
  ` : "";

  app.innerHTML = `
    ${topbarHTML(true, "goHome()", "Kartu Aksi")}
    <div class="panel">
      <div class="mode-title"><span class="mi">${meta.icon}</span><h2>${state.category}</h2></div>
      <div class="mode-sub">🎴 Kategori terpilih acak · Lempar dadu 🎲</div>

      <div class="card-stage">
        <div class="card-face">
          <div class="situasi-only">${card.situasi}</div>
          ${pelajaranHTML}

          <div class="dice-row" style="margin-top:16px;">
            <div class="die ${state.diceRolling?"rolling":""}">${state.diceRolling ? "?" : (state.diceValue || "🎲")}</div>
            <div>${diceResultHTML}</div>
          </div>
        </div>
      </div>

      ${diceTableHTML}

      <div class="btn-row">
        <button class="btn btn-gold" onclick="shuffleCurrent()">🔀 Acak Kartu</button>
        <button class="btn btn-primary" onclick="rollDice()" ${state.diceRolling?"disabled":""}>🎲 Lempar Dadu</button>
        <button class="btn btn-ghost" onclick="toggleDiceTable()">${state.showDiceTable ? "Sembunyikan Tabel" : "📋 Tampilkan Tabel Dadu"}</button>
      </div>
    </div>
  `;
}

/* ============== MAIN RENDER ============== */
function render(){
  if(state.screen === "home") renderHome();
  else if(state.screen === "literasi-play") renderLiterasiPlay();
  else if(state.screen === "aksi-play") renderAksiPlay();
}

render();
</script>
</body>
</html>
